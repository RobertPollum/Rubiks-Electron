{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node-terminal",
            "name": "npm start (Electron, dev)",
            "request": "launch",
            "command": "npm start",
            "cwd": "${workspaceFolder}/rubiks-cube"
        },
        {
            "type": "node-terminal",
            "name": "npm run dev:web (browser)",
            "request": "launch",
            "command": "npm run dev:web",
            "cwd": "${workspaceFolder}/rubiks-cube"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Electron main (debug)",
            "runtimeExecutable": "${workspaceFolder}/rubiks-cube/node_modules/@electron-forge/cli/script/vscode.sh",
            "windows": {
                "runtimeExecutable": "${workspaceFolder}/rubiks-cube/node_modules/@electron-forge/cli/script/vscode.cmd"
            },
            "cwd": "${workspaceFolder}/rubiks-cube",
            "console": "integratedTerminal"
        }
    ]
}
