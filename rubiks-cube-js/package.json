{
  "name": "rubiks-cube-js",
  "productName": "rubiks-cube-js",
  "version": "1.0.0",
  "description": "Rubik's cube simulator that runs as an Electron app or a website",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "dev:web": "vite --config vite.web.config.mjs",
    "build:web": "vite build --config vite.web.config.mjs",
    "preview:web": "vite preview --config vite.web.config.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "echo \"No linting configured\""
  },
  "keywords": [
    "electron",
    "typescript",
    "threejs",
    "Rubik",
    "Rubiks",
    "cube"
  ],
  "author": {
    "name": "Under Penalty",
    "email": "underpenalty@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.8.3",
    "@electron-forge/maker-deb": "^7.8.3",
    "@electron-forge/maker-rpm": "^7.8.3",
    "@electron-forge/maker-squirrel": "^7.8.3",
    "@electron-forge/maker-zip": "^7.8.3",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.3",
    "@electron-forge/plugin-fuses": "^7.8.3",
    "@electron-forge/plugin-vite": "^7.8.3",
    "@electron/fuses": "^1.8.0",
    "electron": "38.0.0",
    "vite": "^5.4.19",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "three": "^0.180.0"
  }
}
